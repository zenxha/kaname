{
  "name": "kaname-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "kaname web app (src/) and scoring engine (core/)",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "cli": "tsx ../cli/rank.ts",
    "dev": "vite",
